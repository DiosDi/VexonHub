local StarterGui = game:GetService("StarterGui")

local callback = Instance.new("BindableFunction")

callback.OnInvoke = function(buttonText)
    if buttonText == "Yes" then
        if setclipboard then
            setclipboard("https://discord.gg/revenang")
        elseif toclipboard then
            toclipboard("https://discord.gg/revenang")
        end
        
        StarterGui:SetCore("SendNotification", {
            Title = "Success",
            Text = "Discord link copied to clipboard!",
            Duration = 5
        })
    elseif buttonText == "No" then
        StarterGui:SetCore("SendNotification", {
            Title = "Dismissed",
            Text = "Have a great day!",
            Duration = 5
        })
    end
end

StarterGui:SetCore("SendNotification", {
    Title = "Notice",
    Text = "VexonHub has been discontinued. You can use Revenant instead. Would you like to copy the Discord link?",
    Duration = 10,
    Button1 = "Yes",
    Button2 = "No",
    Callback = callback
})
